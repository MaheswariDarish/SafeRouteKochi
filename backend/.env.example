# SafeRoute Environment Variables
# Copy to .env and replace with your actual keys

# --- Gemini AI — pick ONE auth mode ---
#
# Mode A: Gemini Developer API (simplest). Get a key from
# https://aistudio.google.com/apikey — it must start with "AIzaSy".
GEMINI_API_KEY=
#
# Mode B: Vertex AI, using your GCP project instead of an API key. Set
# GOOGLE_GENAI_USE_VERTEXAI=true (or just set GOOGLE_CLOUD_PROJECT, either
# is enough to switch modes) and leave GEMINI_API_KEY empty. Vertex AI needs
# to be enabled on the project, and needs Application Default Credentials:
# either point GOOGLE_APPLICATION_CREDENTIALS (below) at a service account
# key JSON with the "Vertex AI User" role, or run
# `gcloud auth application-default login` on this machine.
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Google Maps API Key with Maps JavaScript API & Directions API enabled (Get from Google Cloud Console)
GOOGLE_MAPS_API_KEY=

# Optional: Path to a Google Cloud service account JSON key file. Used for
# Firestore (below) and, in Vertex AI mode, for Gemini too — one file can
# cover both if the service account has both roles. If left empty, SafeRoute
# automatically uses the built-in local emulation store for Firestore, and
# falls back to gcloud ADC for Vertex AI.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: override the Gemini model id (default: gemini-3.6-flash)
GEMINI_MODEL=

# Optional: enable live event scrapers (comma list). Off by default.
# Known sources: reddit  (see backend/data/event_sources.py)
SAFEROUTE_EVENT_SOURCES=

# --- Firestore + Firebase Auth (see backend/SETUP_FIREBASE.md) ---
#
# The backend uses GOOGLE_APPLICATION_CREDENTIALS (above) for the Firebase
# Admin SDK: point it at your service-account JSON and reads/writes go to
# Firestore instead of the local JSON store, AND contribution endpoints start
# requiring a valid Firebase ID token (no anonymous contributions).
#
# The frontend needs the Firebase *web* config too — from the Firebase console
# → Project settings → Your apps → SDK setup and configuration:
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=

# While testing inside a trusted group, new contributions are usable
# immediately. Set to false later and add a review workflow.
AUTO_VERIFY_CONTRIBUTIONS=true

# Require Google sign-in for every contribution (write endpoints 401 without a
# valid Firebase ID token). Only takes effect once Firebase is configured above.
# Leave blank/false during trusted-group testing.
AUTH_ENFORCED=
