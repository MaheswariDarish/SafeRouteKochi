rules_version = '2';

// SafeRoute Firestore rules.
//
// All writes go through the FastAPI backend using the Firebase Admin SDK,
// which BYPASSES these rules. They exist to lock down any *direct* client
// access to Firestore: the browser may read verified public data, but may
// never write. Deploy with:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function isVerified() {
      return resource.data.status == 'verified';
    }

    // Public map data — readable if verified, never client-writable.
    match /segments/{id}       { allow read: if isVerified(); allow write: if false; }
    match /map_features/{id}   { allow read: if isVerified(); allow write: if false; }
    match /community_events/{id} { allow read: if isVerified(); allow write: if false; }

    // Everything else is backend-only. The API already serves these to the
    // browser with rater/reporter identity stripped for anonymous entries, so
    // raw docs (which still carry contributor.uid) must not be client-readable.
    match /trip_surveys/{id}    { allow read, write: if false; }
    match /contributors/{id}    { allow read, write: if false; }
    match /safety_ratings/{id}  { allow read, write: if false; }
    match /live_reports/{id}    { allow read, write: if false; }
    match /event_brochures/{id} { allow read: if true; allow write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
